# ── Personal data: never leaves this machine ────────────────────────────────
# The whole point of the project is that statements stay local. If this repo is
# ever pushed anywhere, these are the files that must not go with it.
data/
statements/
user-state.json
user-state.json.bak
profile.json
mail-log.json
aifinance.db
*.db
.gmail/

# ── Environment ────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
design-samples.html

# Antigravity's own multi-agent scratch space (BRIEFING.md, DISPATCH.md,
# progress.md, etc.) — internal coordination, not project state.
.agents/

# Server log from a detached uvicorn start — runtime output, not source.
.server.log
.server.log.err
